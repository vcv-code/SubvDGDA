MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=bdns_dgda
MYSQL_USER=bdns_user
MYSQL_PASSWORD=cambia_esto
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Orígenes permitidos por CORS. En desarrollo, *. En producción, el dominio real:
# CORS_ORIGINS=https://subvencionesdgda.org
CORS_ORIGINS=*

# ─── Correo saliente ──────────────────────────────────────────────────────────
# En DESARROLLO no hace falta tocar nada: sin estas variables el backend envía a
# Mailpit (http://localhost:8025), que acepta cualquier mensaje sin credenciales.
#
# En PRODUCCIÓN hay que rellenarlas. Ejemplo con Gmail y contraseña de
# aplicación (requiere verificación en dos pasos activada en la cuenta):
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucuenta@gmail.com
#   SMTP_PASSWORD=la_contrasena_de_aplicacion_de_16_letras
#   SMTP_TLS=true
#   EMAIL_FROM=datos.subvencionesdgda@gmail.com
#   EMAIL_CONTACTO=datos.subvencionesdgda@gmail.com
#   SITE_URL=https://subvencionesdgda.org
#
# EMAIL_FROM      remitente de los correos. Debe ser un dominio que exista, o el
#                 proveedor los rechazará o irán a spam.
#
#                 NO uses una cuenta personal: esta dirección la ve todo el que
#                 reciba un correo del sitio. Y evita que parezca oficial: el
#                 dominio ya suena a administración, y si además el remitente
#                 lo parece, la gente escribirá creyendo que aquí se tramitan
#                 subvenciones. En el nombre visible de la cuenta conviene
#                 poner algo como "Subvenciones DGDA · web independiente".
# EMAIL_CONTACTO  buzón que recibe los mensajes del formulario de contacto.
# SITE_URL        base de los enlaces de verificación y recuperación que viajan
#                 DENTRO de los correos. Si apunta a un dominio equivocado, el
#                 enlace de recuperación de contraseña no lleva a ninguna parte.
# SMTP_TLS        true activa STARTTLS (puerto 587). Gmail y Brevo lo exigen.
#
# IMPORTANTE: usa el puerto 587, no el 465. Son dos formas distintas de cifrar
# y aquí solo está implementada la del 587 (STARTTLS). Con el 465 la conexión
# se queda esperando hasta agotar el tiempo de espera y el correo no sale.

# ─── Copias de seguridad ──────────────────────────────────────────────────────
# Días que se conservan los volcados de scripts/backup_db.sh. Por defecto 30.
#
# Frecuencia y retención van unidas: con copias SEMANALES, 30 días dejan solo
# cuatro. En un servidor con copia semanal conviene subirlo:
#
#   BACKUP_DIAS=180      # ~26 copias, medio año, unos 21 MB

# ─── Informes de visitas ──────────────────────────────────────────────────────
# Días que se conservan los informes de scripts/informe_visitas.sh. Por defecto
# 365. Los registros de Nginx solo duran 30 días, así que para tener series
# largas lo que hay que conservar son los informes, no los registros.
#
#   INFORMES_DIAS=365
